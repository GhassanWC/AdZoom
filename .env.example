# ── Firebase (client) ────────────────────────────────────────────────
# Public — exposed to the browser. Copy from Firebase console → Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server) ──────────────────────────────────────────
# Base64-encoded JSON of a service-account key. On GCP-hosted environments
# (App Hosting, Cloud Run) Application Default Credentials are used if absent.
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Gemini (server) ──────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional model override; defaults to gemini-2.5-flash.
GEMINI_MODEL=

# ── Lemon Squeezy (server-only — never expose to the client) ─────────
# Personal API key from LS → Settings → API. Use a TEST-MODE key while
# integrating; flip to a live key for production.
LEMONSQUEEZY_API_KEY=
# Store id (numeric) from LS → Store → Settings.
LEMONSQUEEZY_STORE_ID=
# Variant ids from LS → Products → <product> → Variants. Each tier maps
# to one variant; the webhook uses these to map a checkout back to a plan.
LEMONSQUEEZY_CREATOR_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
# Webhook signing secret from LS → Settings → Webhooks → <webhook>.
# Used to verify HMAC-SHA256 signatures on every webhook delivery.
LEMONSQUEEZY_WEBHOOK_SECRET=
