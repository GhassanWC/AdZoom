# ── App URL ──────────────────────────────────────────────────────────
# Canonical public origin used to build absolute redirect URLs (e.g. the
# Lemon Squeezy checkout success redirect). Falls back to the request
# origin when unset — fine for local dev, REQUIRED in prod where the proxy
# would otherwise expose the internal bind address (https://0.0.0.0:8080).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Firebase (client) ────────────────────────────────────────────────
# Public — exposed to the browser. Copy from Firebase console → Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server) ──────────────────────────────────────────
# Base64-encoded JSON of a service-account key. On GCP-hosted environments
# (App Hosting, Cloud Run) Application Default Credentials are used if absent.
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Gemini (server) ──────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional model override; defaults to gemini-2.5-flash.
GEMINI_MODEL=

# ── Transcript / ASR — OPTIONAL (auto-captions) ──────────────────────
# Leave ALL of these UNSET and captions simply stay "unavailable" (never faked);
# every other edit type (cuts, zooms, speed, hook text, overlays, callouts,
# smart crop, CTA, transitions) works with just GEMINI_API_KEY above.
#
# To turn ON real transcription + auto-captions:
#   TRANSCRIPT_PROVIDER=google_speech
#   TRANSCRIPT_EXECUTION=inline   # in-process ffmpeg. ASR is ASYNC by default —
#       only SHORT videos (≤60s) run inline/synchronously; longer videos are
#       dispatched to the background (via NEXT_PUBLIC_APP_URL → /api/internal/
#       transcribe) so "Generate AI Edit" is never blocked. Captions arrive live
#       when the background job finishes. Best for local/dev + short-clip testing.
#   TRANSCRIPT_EXECUTION=worker   # ALWAYS background — dispatches to a dedicated
#       ffmpeg runtime at TRANSCRIPT_WORKER_URL (prod).
# Requires: the Cloud Speech-to-Text API enabled on the project + a service
# account with Speech + Storage roles (via FIREBASE_SERVICE_ACCOUNT_B64 above or
# GOOGLE_APPLICATION_CREDENTIALS), AND ffmpeg available (see FFMPEG_PATH).
TRANSCRIPT_PROVIDER=
TRANSCRIPT_EXECUTION=
# Falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID when unset.
GOOGLE_CLOUD_PROJECT_ID=
# Path to the ffmpeg binary if it isn't on PATH (needed by the audio extractor).
# Point it at the EXECUTABLE (…\bin\ffmpeg.exe on Windows), not the folder, and
# with NO surrounding quotes. IMPORTANT: Next.js reads .env only at startup —
# after adding/changing this, RESTART `npm run dev` or the running server won't
# see it (it silently falls back to a bare `ffmpeg` → "ffmpeg not found").
FFMPEG_PATH=
# Optional tuning.
TRANSCRIPT_MODEL=latest_long
# LAST-RESORT default spoken language (BCP-47) — used ONLY when the user picked
# "Auto Detect" AND there's no other signal (prior transcript / locale). It NEVER
# overrides a language the user selected in the Analyze dialog. Framevo transcribes
# in the language actually spoken and never translates. Leave as en-US or unset.
TRANSCRIPT_LANGUAGE=en-US
TRANSCRIPT_MAX_DURATION_SECONDS=900
TRANSCRIPT_MAX_FILE_MB=260
# worker mode only — the ffmpeg-equipped runtime that runs /api/internal/transcribe.
TRANSCRIPT_WORKER_URL=
TRANSCRIPT_WORKER_SECRET=

# ── Lemon Squeezy (server-only — never expose to the client) ─────────
# Personal API key from LS → Settings → API. Use a TEST-MODE key while
# integrating; flip to a live key for production.
LEMONSQUEEZY_API_KEY=
# Store id (numeric) from LS → Store → Settings.
LEMONSQUEEZY_STORE_ID=
# Variant ids from LS → Products → <product> → Variants. Each tier maps
# to one variant; the webhook uses these to map a checkout back to a plan.
LEMONSQUEEZY_CREATOR_VARIANT_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=
# Webhook signing secret from LS → Settings → Webhooks → <webhook>.
# Used to verify HMAC-SHA256 signatures on every webhook delivery.
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---- Desktop app sign-in (Google OAuth, installed-app flow) -----------
# Framevo Desktop signs in through the user's REAL browser (PKCE + a 127.0.0.1
# loopback redirect). Google refuses embedded sign-in pages, and an in-app one
# would be indistinguishable from phishing — so the app never renders one.
#
# Create it in Google Cloud Console → APIs & Services → Credentials →
# "Create credentials" → "OAuth client ID" → Application type: **Desktop app**.
# Nothing to register as a redirect URI: loopback is implicit for this type.
#
# The ID is public (it appears in the authorization URL the browser loads), and
# the desktop build picks it up from here automatically (desktop/esbuild.mjs).
# The SECRET is server-only: /api/auth/desktop/exchange uses it to redeem the
# authorization code, and it is NEVER baked into the Electron bundle.
GOOGLE_DESKTOP_OAUTH_CLIENT_ID=
GOOGLE_DESKTOP_OAUTH_CLIENT_SECRET=
