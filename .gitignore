# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright — run artifacts only; e2e/ specs and playwright.config.ts ARE tracked
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but DO commit the *.example templates so collaborators see required vars
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Service build artifacts — ALWAYS built fresh (a stale committed bundle once
# shipped a pre-captions render core; see services/export-worker/dist incident).
services/export-worker/dist/
services/asr-worker/dist/
services/remotion-renderer/dist/
