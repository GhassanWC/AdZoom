# =====================================================================
# AdZoom — PRODUCTION environment template
#
# Copy this file to `.env.production` ONLY when you want to run a
# prod-style build locally (`NODE_ENV=production npm run build && npm start`).
#
# Source of truth for prod: Firebase App Hosting secrets — set them via
#   firebase apphosting:secrets:set <NAME> --project=prod
# NOT this file. This file is for local verification before pushing
# changes to the App Hosting backend.
#
# `.env.production` is gitignored — never commit live secrets.
# =====================================================================

# ---- Firebase (prod project: adzoom-prod) ----------------------------
# Different project, different keys. Sourced from the Firebase Console
# for the adzoom-prod project (Console → Project settings → Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=adzoom-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=adzoom-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=adzoom-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (server only) --------------------------------
# Service-account key for the adzoom-prod project. NEVER reuse the dev
# service account here — that would cross project boundaries.
FIREBASE_SERVICE_ACCOUNT_B64=

# ---- Gemini (AI analysis + chatbot) ----------------------------------
# Recommend a separate prod API key so quota / abuse can be isolated.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---- Lemon Squeezy (billing) -----------------------------------------
# LIVE credentials. These bill real customers. Triple-check before you
# paste anything here.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_CREATOR_VARIANT_ID=
