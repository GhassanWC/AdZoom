{
  "name": "adzoom-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "desktop:install": "npm --prefix desktop install",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:package": "npm --prefix desktop run package:win",
    "desktop:make": "npm --prefix desktop run make",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "desktop:test": "npm --prefix desktop test",
    "desktop:test:e2e": "npm --prefix desktop run test:e2e",
    "gen:icons": "node scripts/gen-icons.mjs",
    "test": "node --import ./tests/register-resolver.mjs --test \"tests/**/*.test.ts\"",
    "bench:editorial": "node --import ./tests/register-resolver.mjs scripts/bench-editorial.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "node scripts/admin-smoke.mjs",
    "worker:install": "npm --prefix services/export-worker install",
    "worker:dev": "npm --prefix services/export-worker run dev",
    "worker:build": "npm --prefix services/export-worker run build",
    "worker:typecheck": "npm --prefix services/export-worker run typecheck",
    "worker:deploy": "node scripts/deploy-worker.mjs",
    "export-api:deploy": "node scripts/deploy-export-api-dotnet.mjs",
    "batch:build": "node scripts/build-batch-worker.mjs",
    "remotion:install": "npm --prefix services/remotion-renderer install",
    "remotion:build": "npm --prefix services/remotion-renderer run build",
    "remotion:typecheck": "npm --prefix services/remotion-renderer run typecheck",
    "remotion:deploy": "node scripts/deploy-remotion-renderer.mjs",
    "fb:whoami": "node scripts/firebase-active.mjs",
    "fb:use:dev": "firebase use dev",
    "fb:use:prod": "firebase use prod",
    "deploy:rules:dev": "node scripts/deploy-rules.mjs --project=dev",
    "deploy:rules:prod": "node scripts/deploy-rules.mjs --project=prod",
    "deploy:indexes:dev": "firebase deploy --only firestore:indexes --project=dev",
    "deploy:indexes:prod": "firebase deploy --only firestore:indexes --project=prod",
    "deploy:cors:dev": "node scripts/deploy-cors.mjs --project=dev",
    "deploy:cors:prod": "node scripts/deploy-cors.mjs --project=prod",
    "deploy:dev": "npm run deploy:rules:dev && npm run deploy:indexes:dev",
    "deploy:prod": "npm run deploy:rules:prod && npm run deploy:indexes:prod",
    "asr:install": "npm --prefix services/asr-worker install",
    "asr:build": "npm --prefix services/asr-worker run build",
    "asr:typecheck": "npm --prefix services/asr-worker run typecheck",
    "asr:deploy": "node scripts/deploy-asr-worker.mjs",
    "emu": "firebase emulators:start --only auth,firestore,storage --project framevo-test",
    "test:integration": "firebase emulators:exec --only auth,firestore,storage --project framevo-test \"npm run test --prefix desktop\"",
    "desktop:audit": "node scripts/audit-desktop-bundle.mjs",
    "desktop:release": "node scripts/desktop-release.mjs",
    "desktop:release:upload": "node scripts/desktop-upload-release.mjs"
  },
  "dependencies": {
    "@editframe/elements": "^0.58.4",
    "@editframe/react": "^0.58.4",
    "@google-cloud/batch": "^2.3.1",
    "@google-cloud/run": "^3.3.0",
    "@google-cloud/tasks": "^6.2.3",
    "@google/genai": "^2.2.0",
    "@remotion/player": "4.0.484",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "mediabunny": "^1.51.0",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.3.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.484",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.6",
    "firebase-tools": "^15.24.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
