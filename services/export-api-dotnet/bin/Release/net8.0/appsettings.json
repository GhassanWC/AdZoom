{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Export": {
    "WorkerConcurrency": 1,
    "PollIntervalSeconds": 5,
    "HeartbeatSeconds": 60,
    "HeartbeatStaleSeconds": 180,
    "ReconcileStaleSeconds": 600,
    "ReconcileIntervalSeconds": 120,
    "X264Crf": 19,
    "X264Preset": "veryfast",
    "NormalizeEnabled": true,
    "NormalizeCrf": 18,
    "NormalizePreset": "veryfast",
    "RenderCliNode": "node",
    "RenderCliEntry": "/app/render-cli/cli.js"
  }
}
