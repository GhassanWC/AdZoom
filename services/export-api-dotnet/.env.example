# ── Framevo export API (C#) — environment ────────────────────────────────────
# Copy to .env (local) or set as Cloud Run env/secrets. Env wins over appsettings.

# GCP project (Firestore + Storage). On Cloud Run this is usually auto via ADC.
GCLOUD_PROJECT=adzoomdev

# Firebase/GCS bucket for source + output objects (REQUIRED).
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=adzoomdev.firebasestorage.app

# Shared secret the Next.js front door sends as `X-Internal-Secret` (REQUIRED).
# Generate a long random value; store in Secret Manager in production.
# (Legacy alias INTERNAL_SECRET is also accepted.)
EXPORT_API_INTERNAL_SECRET=

# Node env passed through to the render-CLI subprocess.
NODE_ENV=production

# Local only — path to a service-account key (Cloud Run uses ADC, leave unset there).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# HTTP port (Cloud Run sets this automatically to 8080).
PORT=8080

# ── Runner tuning (defaults mirror services/export-worker/src/config.ts) ──────
WORKER_CONCURRENCY=1
POLL_INTERVAL_SECONDS=5
HEARTBEAT_SECONDS=60
HEARTBEAT_STALE_SECONDS=180
RECONCILE_STALE_SECONDS=600
RECONCILE_INTERVAL_SECONDS=120

# ── Encode knobs forwarded to the Node render CLI ─────────────────────────────
WORKER_X264_CRF=19
WORKER_X264_PRESET=veryfast
WORKER_NORMALIZE_ENABLED=1
WORKER_NORMALIZE_CRF=18
WORKER_NORMALIZE_PRESET=veryfast

# ── Node render CLI location (set in the image; override only for local dev) ──
RENDER_CLI_NODE=node
RENDER_CLI_ENTRY=/app/render-cli/cli.js

# ── Run mode ──────────────────────────────────────────────────────────────────
# "single-job" → one-shot Google Cloud Batch task (claim ONE job, render, exit).
# "firestore-poll" → long-lived GCE VM poll loop. "disabled" → HTTP control plane.
# In Batch, the submitter (Next.js) injects EXPORT_JOB_ID/EXPORT_JOB_UID per task,
# which auto-selects single-job mode — you do NOT set these by hand.
# EXPORT_WORKER_MODE=single-job
# EXPORT_JOB_ID=
# EXPORT_JOB_UID=
# Single-job startup watchdog: if the container hasn't claimed the job (→ rendering)
# within this many seconds it fails the job + hard-exits so it can't bill forever.
# In single-job mode HEARTBEAT_SECONDS also defaults to 30 (not 60).
# BATCH_STARTUP_TIMEOUT_SECONDS=120

# ── Chunked rendering (SHARDED) ───────────────────────────────────────────────
# Two distinct paths share these knobs:
#   • SHARDED (new): one Batch job with EXPORT_WORKER_COUNT shard tasks. Each worker
#     (BATCH_TASK_INDEX) renders a CONTIGUOUS range of small chunks
#     (chunksPerWorker = ceil(EXPORT_CHUNK_COUNT / EXPORT_WORKER_COUNT);
#      start = workerIndex*chunksPerWorker; end = min(chunkCount, start+chunksPerWorker)),
#     so 24 chunks run on 4–6 workers — NOT 24 containers. The worker that records
#     the last chunk merges. Selected per task by EXPORT_RENDER_MODE=chunked +
#     EXPORT_CHUNK_COUNT + EXPORT_WORKER_COUNT (all injected by the submitter).
#   • LEGACY (sequential, in one container): EXPORT_CHUNKED_RENDER=1 — kept as a
#     fallback; NOT used when EXPORT_RENDER_MODE=chunked.
# EXPORT_RENDER_MODE=chunked       # set by the submitter; not by hand
# EXPORT_CHUNK_COUNT=24            # set by the submitter; TOTAL output chunks (NOT task count)
# EXPORT_WORKER_COUNT=6            # set by the submitter; shard task count (= Batch taskCount)
EXPORT_CHUNKED_RENDER=0
# Small chunks → low per-chunk overhead is amortized by sharding many onto few workers.
EXPORT_CHUNK_SECONDS=15
EXPORT_CHUNK_MIN_SECONDS=180
EXPORT_CHUNK_MAX_RETRIES=2
# Per-shard-task Batch timeout (a worker renders ~chunkCount/workerCount chunks +
# maybe the merge). Set on the Batch job spec by the submitter.
EXPORT_CHUNK_TASK_TIMEOUT_SECONDS=5400
# Merge-leader lease: a merge claim older than this is re-claimable by a retried
# task. MUST sit between worst-case merge time and the 600s stale-reconcile window
# (so a dead leader's merge is re-claimed before the job is failed as stale).
EXPORT_MERGE_LEASE_SECONDS=300
# Boundary padding for chunk windows. Default 0 (exact windows) — today every
# effect is stateless per output frame, so padding is pure wasted decode. The knob
# is fully wired (the chunk renders [render-pad, render+pad] but EMITs only the
# trim window, so pad frames warm temporal state without reaching the encoder), so
# a future temporal effect (motion blur, audio cross-fade, look-ahead easing) can
# enable it with no code change.
EXPORT_CHUNK_BOUNDARY_PADDING_SECONDS=0
