# Framevo export VM worker — copy to `.env` and adjust if needed.
# Defaults target the prod project (adzoom-prod). NO credentials live here:
# Application Default Credentials come from the VM's attached service account.

# ── GCP / Firebase ──────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=adzoom-prod
NEXT_PUBLIC_FIREBASE_PROJECT_ID=adzoom-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=adzoom-prod.firebasestorage.app

# ── Worker behavior ─────────────────────────────────────────────────────────
# One render at a time per VM is the safe default (each render is CPU-heavy).
WORKER_CONCURRENCY=1
# Always normalize the source to a worker-safe normalized-source.mp4 before
# rendering (H.264 + one clean AAC track, or silent fallback). Keep this ON.
WORKER_NORMALIZE_ENABLED=1
# This instance RUNS the Firestore poll/claim/render loop.
EXPORT_WORKER_MODE=firestore-poll

# ── Image ───────────────────────────────────────────────────────────────────
# Pin the image compose pulls (otherwise the :latest default in the compose file
# is used). Bump the tag to roll out a new build.
EXPORT_IMAGE=us-central1-docker.pkg.dev/adzoom-prod/framevo/export-api:latest

# ── Optional ────────────────────────────────────────────────────────────────
# Only needed if you ALSO expose the HTTP enqueue-signal endpoint (poll mode does
# NOT require it). Leaving it unset just means /exports/* return 401 — harmless,
# because rendering is driven by the poller, and /health stays open.
# EXPORT_API_INTERNAL_SECRET=
