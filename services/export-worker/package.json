{
  "name": "framevo-export-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Framevo server-side cloud MP4 export worker (Cloud Run). Renders with the SHARED canvas render core (@napi-rs/canvas) + FFmpeg for decode/encode/audio.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/dev-server.ts",
    "start": "node dist/server.js",
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx --tsconfig tsconfig.json test/e2e.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "firebase-admin": "^13.9.0",
    "google-auth-library": "^9.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
