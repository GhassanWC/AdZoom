rules_version = '2';

// AdZoom Firestore Security Rules — billing-hardened revision.
//
// Security model
// ──────────────
// Anything that affects whether a user can access paid features is OWNED BY
// THE SERVER and read-only to the client:
//   • users/{uid}.plan              ← mirrored from the Lemon Squeezy webhook
//   • subscriptions/{uid}.*         ← written by the LS webhook only
//   • users/{uid}/usage/{period}.*  ← written by the export-permit endpoint
//   • users/{uid}/exports/*         ← created by the export-permit endpoint
//                                     (clients do ONE narrow completion patch)
//   • processedEvents/{eventId}     ← webhook idempotency markers
//
// The user profile + projects + custom presets remain client-owned.
//
// Deploy: `firebase deploy --only firestore:rules` from the repo root. These
// rules MUST be deployed before the billing-hardening code paths are
// trustworthy — until they are, the client can still flip plan = "pro".

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /**
     * True when the incoming update doesn't change any of `forbidden`'s
     * fields. Used for field-level lockdown on docs that mix client-owned
     * and server-owned data (e.g. users/{uid} where `plan` is server-only).
     */
    function notTouchingKeys(forbidden) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(forbidden);
    }

    // ── User profile doc ─────────────────────────────────────────────────
    // Holds displayName/email/photoURL/createdAt/updatedAt (client-writable)
    // AND `plan` (server-only, mirrored from the webhook). Future server-
    // owned fields go in this list:
    //   const SERVER_OWNED_USER_KEYS = ['plan'];
    match /users/{uid} {
      allow read: if isOwner(uid);

      // On create, the client must NOT set `plan` — it's set by the webhook
      // later. ensureUserDoc() in AuthProvider.tsx already never sets it.
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['plan']);

      // On update, the client may change anything EXCEPT `plan`. Lets the
      // existing profile-merge flow keep working without opening a door for
      // self-upgrade.
      allow update: if isOwner(uid) && notTouchingKeys(['plan']);

      allow delete: if false;

      // ── Projects (fully client-owned) ─────────────────────────────────
      match /projects/{projectId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // ── Custom presets (fully client-owned) ───────────────────────────
      match /presets/{presetId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      // ── Progressive analysis jobs (fully client-owned) ────────────────
      // The chunked-analysis orchestrator runs in the browser and writes job
      // + per-chunk state here so a refresh resumes without losing progress.
      // These hold only analysis bookkeeping (chunk windows, statuses, the
      // moments/CV a chunk produced) — nothing billing-relevant — so the
      // same fully-owner-RW model as projects/presets applies.
      match /analysisJobs/{jobId} {
        allow read, create, update, delete: if isOwner(uid);
        match /chunks/{chunkId} {
          allow read, create, update, delete: if isOwner(uid);
        }
      }

      // ── Exports ───────────────────────────────────────────────────────
      // Server creates the export doc via /api/billing/export-permit with
      // `status: "permitted"`. After uploading the bytes to Storage, the
      // client patches a NARROW whitelist of fields to mark it ready.
      // resolution / format / applyWatermark / fps are immutable from the
      // moment the permit was issued.
      match /exports/{exportId} {
        allow read: if isOwner(uid);
        // No client-side creation; everything goes through the permit endpoint.
        allow create: if false;
        // One-shot completion patch: permitted → ready, plus upload-result
        // fields. Anything else is denied.
        //
        // `duration` / `outputWidth` / `outputHeight` describe the FILE that was
        // produced and are only knowable after rendering, so the permit cannot
        // pre-set them. They are safe to let the client write: none of them
        // gates a paid feature, and every field that DOES — resolution, format,
        // fps, applyWatermark, engine, projectId, projectTitle — stays absent
        // from this list and therefore immutable from the moment the permit was
        // issued.
        allow update: if isOwner(uid)
          && resource.data.status == 'permitted'
          && request.resource.data.status == 'ready'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'storagePath', 'exportUrl', 'fileSize', 'completedAt',
                        'duration', 'outputWidth', 'outputHeight']);
        allow delete: if false;
      }

      // ── Cloud export jobs (server-side render) ────────────────────────
      // The PAID cloud MP4 path. `POST /api/export/cloud` creates the job
      // (status "queued") after plan + minutes gating; the Cloud Run worker
      // writes every subsequent status/progress transition via the Admin SDK
      // (which bypasses these rules). The client only ever READS its jobs to
      // drive the live UI — cancellation goes through `POST /api/export/cancel`
      // (which sets `cancelRequested` server-side), NOT a direct write. So the
      // client can forge nothing about a render: status, progress,
      // downloadUrl, consumedExportMinutes, and renderRecipe are all
      // server-owned.
      match /exportJobs/{jobId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;

        // Per-chunk completion markers for parallel chunked exports. Server-only
        // writes (worker via Admin SDK); owner-readable for diagnostics.
        match /chunks/{chunkId} {
          allow read: if isOwner(uid);
          allow create, update, delete: if false;
        }

        // Per-worker heartbeat markers (one per shard worker; 30s cadence). Server-
        // only writes (worker via Admin SDK); owner-readable for diagnostics.
        match /workers/{workerId} {
          allow read: if isOwner(uid);
          allow create, update, delete: if false;
        }
      }

      // ── Monthly usage counters ────────────────────────────────────────
      // Read-only to the owner so the billing page can show "X / Y exports
      // this month" + cloud minutes remaining. All mutations go through the
      // export-permit / export-cloud endpoints.
      match /usage/{periodId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Auto-caption usage ledger (SEPARATE from export minutes) ──────
      // Read-only to the owner so the Analyze dialog can show "X of Y caption
      // minutes used". All writes happen server-side in atomic transactions
      // (see src/lib/usage/caption-ledger.ts) — the client is never trusted
      // with usage values.
      match /captionUsage/{periodId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Workspace settings (client-owned) ─────────────────────────────
      // Single-doc parent for the user's preferences: workspace defaults
      // (default preset id + default export format) + notification
      // preferences. Read by the Settings page, the notifications store,
      // and the new-project creation flow. The user owns these — flipping
      // their own notification preference can't affect billing or grant
      // any premium access, so client-owned is fine.
      match /settings/{settingsDocId} {
        allow read, write: if isOwner(uid);
      }

      // ── API key metadata (server-issued, owner-readable) ──────────────
      // Per-user metadata for issued API keys: name, prefix, SHA-256
      // hash, type, timestamps, revoked flag. The HASH is the secret
      // material — even a leaked metadata read can't authenticate as the
      // user because the validation path also requires `apiKeyIndex/{hash}`
      // (server-locked, below). All writes go through the
      // `/api/settings/api-keys` routes which use the admin SDK; clients
      // never write directly. List + read are owner-only.
      match /apiKeys/{keyId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ── Subscription state (server only) ───────────────────────────────
    // Lemon Squeezy webhook is the only writer; the owner can read their own.
    match /subscriptions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── Webhook idempotency markers (server only — opaque to clients) ──
    match /processedEvents/{eventId} {
      allow read, write: if false;
    }

    // ── API key reverse-lookup index (server only — opaque to clients) ──
    // Maps `sha256(plaintext_api_key)` → { uid, keyId, type, createdAt }.
    // This collection is the secret material for bearer-token resolution
    // in `validateApiKey` (src/lib/firebase/api-keys-server.ts). It MUST
    // NOT be readable by any client — a successful read would let an
    // attacker enumerate valid hashes and brute-force forward to the
    // plaintext. The default-deny rule below would also block this, but
    // we add an EXPLICIT deny so a future overly-permissive
    // `match /{document=**}` change can't silently expose it.
    match /apiKeyIndex/{hash} {
      allow read, write: if false;
    }

    // ── App-owned analytics events ─────────────────────────────────────
    // Product-analytics stream for the admin dashboard. Clients may APPEND
    // their own events (trackEvent) but never read/list/modify — the admin
    // dashboard reads these via the Admin SDK only, so a normal user can't
    // enumerate other users' activity.
    //
    // The create guard:
    //   • userId must equal the caller's uid  → no attribution spoofing
    //   • timestamp must equal request.time    → forces serverTimestamp(),
    //                                             blocks backdating
    //   • eventName is a string ≤ 64 chars      → bounds the field
    //   • only the known keys may be present    → bounds the doc shape
    // Server-originated events (recordEvent, Admin SDK) bypass these rules.
    match /analyticsEvents/{eventId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventName is string
        && request.resource.data.eventName.size() <= 64
        && request.resource.data.timestamp == request.time
        && request.resource.data.keys().hasOnly(
            ['eventName', 'userId', 'userEmail', 'projectId', 'plan',
             'metadata', 'environment', 'timestamp']);
      allow read, update, delete: if false;
    }

    // ── Default deny ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
