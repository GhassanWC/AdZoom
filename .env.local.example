# =====================================================================
# AdZoom — DEV environment template
#
# Copy this file to `.env.local` and fill in the values from the
# adzoomdev Firebase project (Console → Project settings → Your apps).
#
# `.env.local` is gitignored — never commit secrets.
# These values are used by `npm run dev` and the scripts in /scripts.
# =====================================================================

# ---- App URL ---------------------------------------------------------
# Canonical public origin for absolute redirect URLs (billing checkout, etc.).
# Optional in dev — falls back to the request origin. Set it in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Firebase (dev project: adzoomdev) -------------------------------
# All six are public — they're embedded into the client bundle.
# Wrong values here will silently send dev traffic to the wrong project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=adzoomdev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=adzoomdev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=adzoomdev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — enables Firebase Analytics (Google Analytics 4) in the browser.
# Found in Console → Project settings → Your apps (looks like "G-XXXXXXXXXX").
# If unset, all analytics logging cleanly no-ops; Firestore event tracking
# still works regardless.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-4K3ENMDZ0Z

# ---- Admin dashboard (/admin) ----------------------------------------
# Comma-separated allow-list of emails permitted to access the admin
# dashboard + its APIs. ADMIN_EMAILS is the SERVER source of truth (the real
# security gate). NEXT_PUBLIC_ADMIN_EMAILS only hides/shows UI in the browser
# and is non-secret. Keep them in sync.
ADMIN_EMAILS=ghassanwork29@gmail.com
NEXT_PUBLIC_ADMIN_EMAILS=ghassanwork29@gmail.com

# ---- Firebase Admin SDK (server only) --------------------------------
# Base64-encoded JSON of a service account key from the adzoomdev project.
# Get it from: Console → Project settings → Service accounts → Generate new private key.
# Then: `base64 -w0 path/to/key.json` (Linux/Mac) or
#       `[Convert]::ToBase64String([IO.File]::ReadAllBytes("path/to/key.json"))` (PowerShell).
FIREBASE_SERVICE_ACCOUNT_B64=

# ---- Gemini (AI analysis + chatbot) ----------------------------------
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash. Override if a newer model
# is preferred for the analyzer / chatbot.
# GEMINI_MODEL=gemini-2.5-flash

# ---- Lemon Squeezy (billing) -----------------------------------------
# Use SANDBOX credentials in dev. Real charges happen on the live key.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_CREATOR_VARIANT_ID=

# ---- Cloud MP4 export (paid, server-side worker) ---------------------
# Server-authoritative kill switch — cloud export stays dark until "true"
# even if the worker is deployed. The NEXT_PUBLIC_ mirror gates the UI.
# CLOUD_EXPORT_ENABLED=true
# NEXT_PUBLIC_CLOUD_EXPORT_ENABLED=true
# Shared secret for the stale-job reconciler cron
# (POST /api/cron/reconcile-exports with header `x-cron-secret: <value>`).
# Set the SAME value on the Cloud Scheduler job that calls the endpoint.
EXPORT_RECONCILE_SECRET=

# Render backend selector. "dotnet" routes jobs to the C# export API
# (services/export-api-dotnet); anything else (default) keeps the old Node
# Cloud-Tasks worker path. Next.js still owns auth + plan + minute reservation +
# job creation either way.
EXPORT_BACKEND=cloudtasks
# C# export API (used only when EXPORT_BACKEND=dotnet):
EXPORT_API_URL=
# Same secret the C# service reads as EXPORT_API_INTERNAL_SECRET (sent as X-Internal-Secret).
EXPORT_API_INTERNAL_SECRET=
