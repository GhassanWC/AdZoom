rules_version = '2';

// AdZoom Storage Rules.
//
// All user objects live under `users/{uid}/...`. Within that prefix we have:
//   • users/{uid}/projects/{projectId}/<source-video>          (uploads)
//   • users/{uid}/projects/{projectId}/exports/{exportId}.<ext> (renders)
//   • users/{uid}/projects/{projectId}/interactions.json       (event manifest)
//
// All require owner auth + a video MIME type + a 4 GB cap. The exports path
// is additionally enforced by Firestore rules — the doc has to exist at
// `users/{uid}/exports/{exportId}` in `status: "permitted"` before the
// completion patch can flip it to "ready". This means a bytes-only upload
// without a permit lands in Storage but never becomes visible to the user.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAcceptableVideo() {
      return request.resource.contentType.matches("video/.*")
          || request.resource.contentType == "application/octet-stream";
    }

    function withinSizeLimit() {
      // 4 GB — generous enough for a 4K export, blocks malicious bulk uploads.
      return request.resource.size < 4 * 1024 * 1024 * 1024;
    }

    // Source videos + interaction manifests live anywhere under the user's
    // own prefix. Owner only.
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && withinSizeLimit() && isAcceptableVideo();
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
